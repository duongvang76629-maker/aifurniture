# ============================================================================
# aifurniture.lol — 环境变量模板
# 用法：cp .env.example .env.local，然后逐项填入真实值。
# .env.local 含密钥，已被 .gitignore 忽略，切勿提交。
# 生产环境非敏感项写在 .env.production；密钥在 Vercel 后台
# Settings → Environment Variables 中配置。
# ============================================================================

# ----------------------------------------------------------------------------
# 0. 应用 / NextAuth
# ----------------------------------------------------------------------------
# 站点对外访问地址。本地默认 3000；文档示例用的是 80 端口（http://localhost）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NextAuth 回调基址，必须与访问地址一致
NEXTAUTH_URL=http://localhost:3000
# Session 加密密钥（≥32 位随机串），生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# ----------------------------------------------------------------------------
# 1. PostgreSQL（任意 PostgreSQL：自建 / Neon / Supabase / RDS 均可）
#    建库后执行 sql/01_init.sql 创建数据表。
# ----------------------------------------------------------------------------
# 本地示例：postgresql://aifurniture:aifurniture@localhost:5432/aifurniture
# 云库一般带 sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/aifurniture

# ----------------------------------------------------------------------------
# 2. Google 登录（Google Cloud → APIs & Services → Credentials 创建 OAuth 客户端）
#    Authorized JavaScript origins:
#      http://localhost:3000
#      https://aifurniture.lol
#    Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://aifurniture.lol/api/auth/callback/google
#    参考：https://github.com/SoraWebui/SoraWebui/blob/login/help/Google-Auth.md
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 3. Cloudflare R2（存储生成的效果图）
#    后台 R2 → Manage R2 API Tokens 创建 Access Key；先创建 Bucket。
#    另需在 Cloudflare「图像 → 转换」里针对图片访问域名开启 URL 图片压缩。
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aifurniture-images
# Bucket 公开访问基址（绑定自定义域名或 r2.dev 公开地址）
R2_PUBLIC_URL=https://images.aifurniture.lol

# ----------------------------------------------------------------------------
# 4. Stripe 订阅支付（价格与商品在 Stripe 后台创建后，把 ID 填到下面）
#    本地用测试模式即可跑通（卡号 4242 4242 4242 4242）。
#    上线还需配置 Stripe Webhook：
#      端点 https://aifurniture.lol/api/stripe/webhook
#      事件 checkout.session.completed、customer.subscription.updated、
#           customer.subscription.deleted
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# stripe listen（本地）或后台 webhook 端点的 Signing secret
STRIPE_WEBHOOK_SECRET=whsec_
# 两个 Price 的 ID：月付 / 年付（当前配置 1 月付 + 1 年付）
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_YEARLY=price_

# ----------------------------------------------------------------------------
# 5. Replicate（渲染模型回调）
#    生成结果通过 Replicate 回调接收，因此本地址必须是公网可达 URL。
#    本地调试用 ngrok：https://xxxx.ngrok-free.app/api/replicate/webhook
#    线上配置为：https://aifurniture.lol/api/replicate/webhook
# ----------------------------------------------------------------------------
REPLICATE_API_TOKEN=r8_
REPLICATE_WEBHOOK_URL=https://example.ngrok-free.app/api/replicate/webhook
# 自定义回调校验密钥（可选，放在 webhook URL 的 ?secret= 或由调用方校验）
REPLICATE_WEBHOOK_SECRET=
# 空间渲染模型（按需更换为家居/室内设计模型）
REPLICATE_MODEL=black-forest-labs/flux-schnell

# ----------------------------------------------------------------------------
# 6. 定时任务（Vercel Cron，见 vercel.json）
#    Vercel Hobby 免费版只允许每天级别的 cron，每分钟任务仅 Pro 生效；
#    不需要可删除 vercel.json，改用自有服务器脚本调用该接口。
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# 7. 本地 Mock 模式（仅开发用）
#    true 时生成接口不调用 Replicate，任务直接成功并返回效果图，
#    便于在没有真实凭据时本地端到端开发；拿到真实凭据后置为 false。
# ----------------------------------------------------------------------------
MOCK_SERVICES=false
