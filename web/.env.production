# ============================================================================
# aifurniture.lol — 生产环境非敏感配置
# Next.js 仅在 build/start 时加载本文件；所有密钥请在 Vercel 后台配置，
# 不要把真实 sk_live_ / r8_ / 数据库口令写进本文件并提交。
# ============================================================================

NEXT_PUBLIC_SITE_URL=https://aifurniture.lol
NEXTAUTH_URL=https://aifurniture.lol

R2_BUCKET_NAME=aifurniture-images
R2_PUBLIC_URL=https://images.aifurniture.lol

# 渲染结果回调即线上域名（Replicate 后台 / 发起预测时使用）
REPLICATE_WEBHOOK_URL=https://aifurniture.lol/api/replicate/webhook

# ---- 以下为生产密钥，在 Vercel → Settings → Environment Variables 配置 ----
# NEXTAUTH_SECRET
# DATABASE_URL
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# STRIPE_SECRET_KEY
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PRICE_MONTHLY
# STRIPE_PRICE_YEARLY
# REPLICATE_API_TOKEN
# REPLICATE_WEBHOOK_SECRET
# CRON_SECRET
